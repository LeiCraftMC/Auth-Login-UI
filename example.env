# LeiCraftMC Auth Login — environment (prefix LCMC_AUTH_LOGIN_). Names in parentheses are the
# Zitadel login (apps/login) variables they replace.
#
# Booleans: any non-empty value (even "false") is true — leave empty for false; an unset variable
# falls back to the schema default.

LCMC_AUTH_LOGIN_LOG_LEVEL=info
LCMC_AUTH_LOGIN_API_DISABLE_DOCS=

# --- Zitadel (system API user, virtual instances) --------------------------------------------
# The instance is selected per request from the Host / x-zitadel-instance-host header.
LCMC_AUTH_LOGIN_ZITADEL_API_URL=http://localhost:8080
# (AUDIENCE) — the system API audience, usually the Zitadel external URL
LCMC_AUTH_LOGIN_AUDIENCE=http://localhost:8080
# (SYSTEM_USER_ID)
LCMC_AUTH_LOGIN_SYSTEM_USER_ID=login-ui
# (SYSTEM_USER_PRIVATE_KEY / _FILE) — PEM, base64-encoded or raw with literal \n; or a file path
LCMC_AUTH_LOGIN_SYSTEM_USER_PRIVATE_KEY=
LCMC_AUTH_LOGIN_SYSTEM_USER_PRIVATE_KEY_FILE=./data/system-user.pem

# (ZITADEL_SESSION_COOKIE_SECRET) — signs the `sessions` cookie; comma-separated for rotation
# (first signs, all verify), each ≥ 32 characters: `openssl rand -base64 32`. Share it with a
# Zitadel login running on the same domain to keep the cookies interchangeable.
LCMC_AUTH_LOGIN_SESSION_COOKIE_SECRET=

# (CUSTOM_REQUEST_HEADERS) — "key:value" pairs sent to Zitadel, comma-separated; an empty value
# removes the header, e.g. Host:zitadel.internal:8080
LCMC_AUTH_LOGIN_CUSTOM_REQUEST_HEADERS=

# --- Login behaviour ----------------------------------------------------------------------------
# (DEFAULT_REDIRECT_URI) — after a login without an OIDC/SAML request; "/…" is relative to the host
LCMC_AUTH_LOGIN_DEFAULT_REDIRECT_URI=
# (EMAIL_VERIFICATION) — require a verified email
LCMC_AUTH_LOGIN_EMAIL_VERIFICATION=
# (NEXT_PUBLIC_AUTO_SUBMIT_CODE) — submit codes from email links automatically
LCMC_AUTH_LOGIN_AUTO_SUBMIT_CODE=
# (ZITADEL_UI_LOCALES_OVERRIDE_COOKIE) — ui_locales of an auth request win over the language cookie
LCMC_AUTH_LOGIN_UI_LOCALES_OVERRIDE_COOKIE=
# (NEXT_PUBLIC_APPLICATION_NAME) — replaces "Zitadel" in the built-in texts
LCMC_AUTH_LOGIN_APPLICATION_NAME=LeiCraftMC Auth

# --- Caching & security -------------------------------------------------------------------------
# (API_CACHE_ENABLED / API_CACHE_CONFIG)
LCMC_AUTH_LOGIN_API_CACHE_ENABLED=true
LCMC_AUTH_LOGIN_API_CACHE_CONFIG=
# (CSP_FETCH_ENABLED) — frame-ancestors from the instance's embedded-iframe settings
LCMC_AUTH_LOGIN_CSP_FETCH_ENABLED=true
# Proxy /.well-known, /oauth, /oidc, /idps/callback, /saml, /assets (under the base path) to Zitadel
LCMC_AUTH_LOGIN_PROXY_ZITADEL_PATHS=true
# (SERVER_ACTION_ALLOWED_ORIGINS) — extra origins allowed to call the API with cookies
LCMC_AUTH_LOGIN_ALLOWED_ORIGINS=

# --- Nuxt ---------------------------------------------------------------------------------------
# (NEXT_PUBLIC_BASE_PATH) — where the login is served; Zitadel's default login URL is
# /ui/v2/login/login?authRequest=
NUXT_APP_BASE_URL=/ui/v2/login/
