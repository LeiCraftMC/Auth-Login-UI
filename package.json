{
	"name": "@leicraftmc/auth-login-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "LeiCraftMC Auth Login UI — a Zitadel Login V2 compatible login for virtual instances, built on the LeiCraft_MC fullstack Nuxt style.",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun nuxt typecheck && bunx --bun tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"api-client:generate": "bun scripts/api-client-generate.ts",
		"proto:generate": "bun scripts/proto-generate.ts",
		"dev": "bunx --bun nuxt dev --port 12192",
		"generate": "bunx --bun nuxt generate",
		"preview": "bunx --bun nuxt preview",
		"postinstall": "bunx --bun nuxt prepare",
		"build": "nuxt build --preset bun",
		"start": "PORT=12192 bun run .output/server/index.mjs"
	},
	"dependencies": {
		"@braintree/sanitize-url": "^7.1.2",
		"@bufbuild/protobuf": "^2.16.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-web": "^2.2.0",
		"@hono/standard-validator": "^0.4.0",
		"@nuxt/ui": "^4.11.2",
		"@scalar/hono-api-reference": "^0.12.7",
		"hono": "^4.13.11",
		"hono-openapi": "^1.3.3",
		"jose": "^6.2.12",
		"nuxt": "^4.5.2",
		"ua-parser-js": "^1.0.41",
		"uqr": "^0.1.3",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@bufbuild/protoplugin": "^2.16.0",
		"@hey-api/nuxt": "^0.2.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@iconify-json/lucide": "^1.2.137",
		"@types/ua-parser-js": "^0.7.39",
		"bun-types": "^1.4.2",
		"protobufjs": "^7.6.6",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.11"
	}
}
